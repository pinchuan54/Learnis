{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Learnis",
  "version": "0.2.9",
  "identifier": "io.github.pinchuan54.learnis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Learnis",
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "pinchuan54",
    "copyright": "© 2026 pinchuan54",
    "category": "Education",
    "shortDescription": "本地学习计划与计时软件",
    "longDescription": "为想掌握的技能设定总时长和期限，Learnis 会把时长分配到期限内的每个学习日，用计时器记录实际学习时间，在月历上查看进度。数据全部保存在本机。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDQTAxNDMwMjFDOUEzQjAKUldTd284a2hNQlNnbkxtNW1tTC8xVFF0TFY3WG1JM3crVzR1Q3FiMlE1ZFZSUzJ4MnB0UEpTdVYK",
      "endpoints": ["https://github.com/pinchuan54/Learnis/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
